# Default deny: no captures, .git, dotenv files, keys, DBs or local assets.
**
!go.mod
!go.sum
!main.go
!certificates/
!certificates/*.crt
!internal/
!internal/**/
!internal/**/*.go
# Tests are verified outside the image; keep fixtures and test-only text out.
**/*_test.go

!internal/database/migrations/*.up.sql
